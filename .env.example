# 🔧 Credenciais de DESENVOLVIMENTO LOCAL (já funcionam como estão).
# O docker-compose.yml usa estes mesmos valores como padrão, então nem é
# preciso copiar este arquivo: `docker compose up -d --build` já sobe tudo.
#
# ⚠️  Produção usa outros valores, gerados aleatoriamente pelo
#     deploy/install-ubuntu-server.sh. NUNCA reutilize estes lá.

# 🐘 Senha do usuário "acme" no PostgreSQL
POSTGRES_PASSWORD=lcr-local-dev-pg-2026

# 🔐 Protege as chaves privadas da AC Raiz e da Intermediária (mín. 12 caracteres).
#    Se mudar depois da primeira execução, a AC não abre mais: apague o volume
#    (docker compose down -v) para recriar a hierarquia.
AC_SENHA=lcr-local-dev-ac-2026

# 🌐 URL gravada nos certificados (LCR/AIA) e no carimbo "Verifique em ..."
PUBLIC_URL=http://localhost:8080

# 🍪 Cookie de sessão só por HTTPS? Localmente é http, então false.
COOKIE_SECURE=false
